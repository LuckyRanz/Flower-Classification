# ============================================================
#  这个文件决定了「哪些东西不进 git」
#  规则：能重新生成的、体积大的、跟机器绑定的，都不进。
# ============================================================

# ---- 数据集（679 MB，8192 个文件）----
# 别人 clone 之后跑 python fetch_data.py 自己下就行，不必塞进仓库。
# 其中 102flowers.tgz 单个就 329 MB，超过 GitHub 的 100 MB 单文件上限。
data/

# ---- 训练产物（权重 45 MB / 日志 / 混淆矩阵）----
# 这些是「跑出来的」，不是「写出来的」——重跑一次就有。
outputs/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 编辑器 / 系统杂项 ----
.DS_Store
Thumbs.db
desktop.ini
